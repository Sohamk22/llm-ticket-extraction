# AI in Practice I - Configuration
# Choose one profile: gemini (recommended), nvidia, groq, anthropic, openai, ollama
AIP_PROFILE=gemini

# Gemini API Key (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Alternative provider keys:
# NVIDIA_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional settings:
# AIP_BUDGET_USD=2.0
# AIP_CACHE=1
# AIP_OFFLINE=0
